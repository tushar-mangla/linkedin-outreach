{
  "name": "linkedin-outreach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A LinkedIn outreach automation tool with ICP qualification.",
  "main": "api/dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "api:dev": "tsx watch src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx dotenv-cli -e .env -- tsx src/migrate.ts",
    "db:push": "npx dotenv-cli -e .env -- drizzle-kit push --accept-data-loss",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "pg-mem": "^3.0.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "@types/uuid": "^10.0.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.8.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  }
}
